#!/bin/bash
#PBS -N lapa_depth_train
#PBS -q normal
#PBS -P 11714283
#PBS -l select=1:ncpus=112:ngpus=4
#PBS -l walltime=24:00:00
#PBS -j oe

set -Eeuo pipefail

cd ~/scratch/projects/lapa-depth-modified-levi
source ~/scratch/venvs/lapa-depth/bin/activate

# Both styles are accepted:
#   qsub -v MODEL=model2,SUITE=libero_spatial run_job.pbs
#   qsub -v model=model2,suite=libero_spatial run_job.pbs
MODEL="${MODEL:-${model:-model2}}"
SUITE="${SUITE:-${suite:-libero_spatial}}"
case "$MODEL" in
  model2|model4|model5) ;;
  *)
    echo "ERROR: MODEL must be model2, model4, or model5; got: $MODEL" >&2
    exit 2
    ;;
esac

export MODEL
export SUITE
export STAGE25_MODEL_NAME="$MODEL"
export LAPA_ROOT="$(pwd -P)"

export TOTAL_STEPS="${TOTAL_STEPS:-20000}"
export BATCH_SIZE="${BATCH_SIZE:-128}"
export MESH_DIM="${MESH_DIM:-!-1,4,1,1}"

export TOKENIZER_PROCESSES="${TOKENIZER_PROCESSES:-1}"
export TOKENIZER_PARALLEL_CHUNK_SIZE="${TOKENIZER_PARALLEL_CHUNK_SIZE:-128}"
export TOKENIZER_PARALLEL_BATCH_SIZE="${TOKENIZER_PARALLEL_BATCH_SIZE:-128}"
export LOG_FREQ="${LOG_FREQ:-1}"
export EVAL_STEPS="${EVAL_STEPS:-0}"

export SAVE_MODEL_FREQ="${SAVE_MODEL_FREQ:-1000}"
export SAVE_MILESTONE_FREQ="${SAVE_MILESTONE_FREQ:-1000}"
export AUTORESUME="${AUTORESUME:-False}"
export SAVE_OPTIMIZER_STATE="${SAVE_OPTIMIZER_STATE:-False}"
export RUNTIME_LOG_STEPS="${RUNTIME_LOG_STEPS:-3}"
export WANDB_ONLINE="${WANDB_ONLINE:-False}"

BASE_EXPERIMENT_ID="${BASE_EXPERIMENT_ID:-${BATCH_SIZE}_batch_${MODEL}_${SUITE}}"
EXPERIMENT_ID="$BASE_EXPERIMENT_ID"
RUN_ID=0
while [[ -e "$LAPA_ROOT/outputs/$EXPERIMENT_ID" ]]; do
  RUN_ID=$((RUN_ID + 1))
  EXPERIMENT_ID="${BASE_EXPERIMENT_ID}_${RUN_ID}"
done
export EXPERIMENT_ID

LOG_DIR="$LAPA_ROOT/logs"
mkdir -p "$LOG_DIR"
JOB_ID="${PBS_JOBID:-manual}"
TIMESTAMP="$(date '+%Y%m%d_%H%M%S')"
LOG_FILE="$LOG_DIR/${EXPERIMENT_ID}_${JOB_ID}_${TIMESTAMP}.log"

echo "============================================================"
echo "Job ID:               $JOB_ID"
echo "Model:                $MODEL"
echo "Suite:                $SUITE"
echo "Experiment:           $EXPERIMENT_ID"
echo "Output directory:     $LAPA_ROOT/outputs/$EXPERIMENT_ID"
echo "Host:                 $(hostname)"
echo "Total steps:          $TOTAL_STEPS"
echo "Batch size:           $BATCH_SIZE"
echo "Autoresume:           $AUTORESUME"
echo "Save optimizer state: $SAVE_OPTIMIZER_STATE"
echo "Log file:             $LOG_FILE"
echo "Start time:           $(date)"
echo "============================================================"

set +e
MODEL="$MODEL" STAGE25_MODEL_NAME="$MODEL" SUITE="$SUITE" \
  bash scripts/train_lapa_depth_suite.sh 2>&1 | tee -a "$LOG_FILE"
TRAIN_EXIT_CODE=${PIPESTATUS[0]}
set -e

echo "============================================================" | tee -a "$LOG_FILE"
echo "End time:  $(date)" | tee -a "$LOG_FILE"
echo "Exit code: $TRAIN_EXIT_CODE" | tee -a "$LOG_FILE"
echo "Log file:  $LOG_FILE" | tee -a "$LOG_FILE"
echo "============================================================" | tee -a "$LOG_FILE"

exit "$TRAIN_EXIT_CODE"
