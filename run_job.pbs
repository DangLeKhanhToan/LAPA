#!/usr/bin/env bash
# Portable PBS entry point. Keep site-specific #PBS resource directives in the
# submission command or in a cluster-local copy of this file.
set -euo pipefail

cd "${PBS_O_WORKDIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}"

export STAGE25_MODEL_NAME="${MODEL:-${STAGE25_MODEL_NAME:-model4}}"
export SUITE="${SUITE:-libero_90}"
export ACTION_FUSION_METHOD="${ACTION_FUSION_METHOD:-project}"
export TOTAL_STEPS="${TOTAL_STEPS:-20000}"
export AUTORESUME="${AUTORESUME:-${RESUME:-False}}"
export SAVE_OPTIMIZER_STATE="${SAVE_OPTIMIZER_STATE:-False}"

exec bash scripts/train_lapa_depth_suite.sh
